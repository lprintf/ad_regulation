{
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        },
    },
    "isort.args": [
        "--profile",
        "black"
    ],
    "flake8.args": [
        "--ignore=E501,W503,E226,E203"
    ],
    "python.analysis.extraPaths": [
        "${workspaceFolder}"
    ],
    "jupyter.notebookFileRoot": "${workspaceFolder}",
    "python.terminal.executeInFileDir": false,
    "terminal.integrated.env.windows": {
        "PYTHONPATH": "${workspaceFolder}",
        "ENV_FILE": "${workspaceFolder}/.env",
        "ANTHROPIC_BASE_URL": "https://q.quuvv.cn",
        "ANTHROPIC_AUTH_TOKEN": "sk-9cPF4AhipgYi0S6NG2Iz0r26PYSwkJTJYWbGbB5QRmVrB5To"
    },
    "terminal.integrated.env.osx": {
        "PYTHONPATH": "${workspaceFolder}",
        "ENV_FILE": "${workspaceFolder}/.env"
    },
    "terminal.integrated.env.linux": {
        "PYTHONPATH": "${workspaceFolder}",
        "ENV_FILE": "${workspaceFolder}/.env"
    },
    "python.envFile": "${workspaceFolder}/.env", // 使用该配置，可在开发和生产环境中绕过dotenv库的使用
    "cSpell.words": [
        "adobject",
        "adset",
        "adsets",
        "deepseek",
        "doubao",
        "fewshot",
        "FRESHDESK",
        "INITDB",
        "lookback",
        "pinterest",
        "pipreqs",
        "pycache",
        "ROAS",
        "venv"
    ],
    "[markdown]": {
        "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
        "editor.formatOnSave": true
    },
    // "markdownlint.config": {
    //     "default": true,
    //     "MD013": false, // Disable line length rule
    //     "MD033": false  // Allow inline HTML
    // }
    "terminal.integrated.profiles.windows": {
        "Git Bash": {
            "path": "C:\\Program Files\\Git\\bin\\bash.exe",
            "args": [
                "--login",
                "-i",
                "-c",
                "set -a; [ -f .env ] && . .env; set +a; exec bash"
            ],
            "icon": "terminal-bash"
        },
        "Command Prompt": {
            "path": [
                "C:\\Windows\\System32\\cmd.exe"
            ],
            "args": [],
            "icon": "terminal-cmd"
        },
        "PowerShell": {
            "path": [
                "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
            ],
            "args": [],
            "icon": "terminal-powershell"
        }
    },
    "terminal.integrated.defaultProfile.windows": "Git Bash",
    "terminal.integrated.profiles.osx": {
        "zsh": {
            "path": "/bin/zsh",
            "args": [],
            "icon": "terminal-bash"
        },
        "bash": {
            "path": "/bin/bash",
            "args": [],
            "icon": "terminal-bash"
        }
    },
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.profiles.linux": {
        "bash": {
            "path": "/bin/bash",
            "args": [],
            "icon": "terminal-bash"
        },
        "zsh": {
            "path": "/usr/bin/zsh",
            "args": [],
            "icon": "terminal-bash"
        }
    },
    "terminal.integrated.defaultProfile.linux": "bash",
    "python.terminal.activateEnvironment": true,
    // "search.exclude": {
    //     "**/node_modules": true,
    //     "**/.git": true,
    //     "**/temp": true,
    //     "**/logs": true
